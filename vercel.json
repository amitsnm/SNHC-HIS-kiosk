{
  "rewrites": [
    {
      "source": "/karexpert/:path*",
      "destination": "https://nirankarihealthcity.karexpert.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/karexpert/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ]
}

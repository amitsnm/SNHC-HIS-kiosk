{
  "rewrites": [
    {
      "source": "/karexpert",
      "destination": "/api/karexpert?path="
    },
    {
      "source": "/karexpert/",
      "destination": "/api/karexpert?path="
    },
    {
      "source": "/karexpert/:path*",
      "destination": "/api/karexpert?path=:path*"
    },
    {
      "source": "/account-management/:path*",
      "destination": "/api/karexpert?path=account-management/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/api/karexpert?path=assets/:path*"
    }
  ]
}
